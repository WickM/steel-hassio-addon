#!/usr/bin/bashio
# s6-overlay cont-init.d/10-config — runs once at boot, before services.
# Validates addon options, prepares persistent data dirs, exports env.
# Tolerant: log + non-zero exit only on fatal misconfig.
#
# IMPORTANT: bashio internally sets `set -u` (nounset) at script start,
# so any reference to an unset var before its assignment will fatal
# the whole cont-init. We disable BOTH -u and -e up front to make
# option-reading tolerant, then re-enable -e at the end so a fatal
# misconfig still fails the container instead of silently starting
# with defaults.
set +eu
OPTIONS_FILE="/data/options.json"   # must be defined before any reference (bashio sets -u)

# (don't add anything here that uses unset variables — assign first.)
if declare -F bashio::config >/dev/null 2>&1; then
    echo "[10-config] bashio loaded: OK"
else
    echo "[10-config] bashio NOT loaded — falling back to jq"
fi

# DEBUG v0.1.13: show what we can actually read. Tells us whether bashio is
# silent-empty (403 from supervisor API) or whether /data/options.json is
# missing/empty. Previous v0.1.4-v0.1.12 versions had an escaped-quote bug
# in the inline jq query that always returned "<jq-error>" — masking whether
# /data/options.json even had a value. We now read into a variable first,
# then echo it, so the jq query string is single-quoted and bash-safe.
if [ -f "${OPTIONS_FILE}" ]; then
    echo "[10-config] DEBUG options.json present, size=$(stat -c%s "${OPTIONS_FILE}") bytes"
    _raw_host_url="$(jq -r '.host_url // "<missing>"' "${OPTIONS_FILE}" 2>/dev/null || echo '<jq-error>')"
    echo "[10-config] DEBUG raw host_url field: '${_raw_host_url}'"
else
    echo "[10-config] DEBUG options.json MISSING at ${OPTIONS_FILE}"
fi
if declare -F bashio::config >/dev/null 2>&1; then
    _bashio_host_url="$(bashio::config 'host_url' '<bashio-empty>' 2>&1 || echo '<bashio-error>')"
    echo "[10-config] DEBUG bashio host_url probe: '${_bashio_host_url}'"
fi

OPTIONS_FILE="/data/options.json"   # explicit re-affirm after DEBUG block

# Same bashio/jq fallback pattern as cognee-addon (v0.1.3 lesson):
# bashio can be loaded (function exists) but every call to the Supervisor
# API returns 403 forbidden (e.g. sideloaded image, missing supervisor
# token). In that case bashio silently returns the default even though
# /data/options.json is mounted with real values.
_USE_JQ_FLAG="/tmp/.steel-use-jq"
rm -f "${_USE_JQ_FLAG}"

_bashio_config() {
    local key="$1"
    local default="$2"

    if [ -f "${_USE_JQ_FLAG}" ]; then
        if [ -f "${OPTIONS_FILE}" ]; then
            local val
            val="$(jq -r --arg k "${key}" 'if (.[$k] == null) then empty else .[$k] end' "${OPTIONS_FILE}" 2>/dev/null)"
            if [ -n "${val}" ]; then echo "${val}"; return; fi
        fi
        echo "${default}"
        return
    fi

    if declare -F bashio::config >/dev/null 2>&1; then
        local bashio_val
        bashio_val="$(bashio::config "${key}" "${default}" 2>/dev/null)"
        # Probe: for any "important" key, if bashio returned empty/placeholder
        # but jq finds a value, latch jq mode. Triggers for steel_api_key
        # (always) and host_url (v0.1.13: was missing — caused user's
        # configured host_url to be silently ignored when bashio 403'd).
        if { [ "${key}" = "steel_api_key" ] || [ "${key}" = "host_url" ]; } \
                && [ -z "${bashio_val}" ] && [ -f "${OPTIONS_FILE}" ]; then
            local jq_val
            jq_val="$(jq -r --arg k "${key}" 'if (.[$k] == null) then empty else .[$k] end' "${OPTIONS_FILE}" 2>/dev/null)"
            if [ -n "${jq_val}" ]; then
                echo "[10-config] bashio returned empty for ${key} but options.json has value='${jq_val}' — switching to jq fallback" >&2
                touch "${_USE_JQ_FLAG}"
                echo "${jq_val}"
                return
            fi
        fi
        if [ -z "${bashio_val}" ] && [ -n "${default}" ]; then
            bashio_val="${default}"
        fi
        echo "${bashio_val}"
        return
    fi

    if [ -f "${OPTIONS_FILE}" ]; then
        local val
        val="$(jq -r --arg k "${key}" 'if (.[$k] == null) then empty else .[$k] end' "${OPTIONS_FILE}" 2>/dev/null)"
        if [ -z "${val}" ]; then echo "${default}"; else echo "${val}"; fi
    else
        echo "${default}"
    fi
}

# ---- Host URL passthrough ----
# Steel's own default for HOST is 0.0.0.0 (see api/src/env.ts in steel-browser
# repo), which Steel embeds verbatim into all self-generated URLs
# (debugUrl, websocketUrl, devtoolsInspectorUrl, sessionViewerUrl, Swagger
# "Server" field). 0.0.0.0 in those URLs makes the UI unreachable from a
# real browser. We must ALWAYS set HOST — either from host_url, the
# user's host_url option, or by auto-detecting the container's own IP.
# Leaving HOST unset is strictly worse than any choice, because Steel
# falls back to 0.0.0.0 and break the UI.
#
# v0.1.11 lesson: hardcoding 172.30.32.1 broke things because that's
# the openclaw-Companion IP, NOT the Steel-addon's own IP. Steel crashes
# with EADDRNOTAVAIL if it can't bind its own claimed address.
#
# v0.1.12 lesson: _bashio_config must be defined BEFORE it's called.
# Earlier revisions called `_bashio_config 'host_url'` before the
# function was defined, which silently returned empty → forced
# auto-detect path → wrong IP. Now the function is defined first.
_FORCED_HOST="$(_bashio_config 'host_url' '')"
if [ -n "${_FORCED_HOST}" ]; then
    echo "[10-config] forcing HOST=${_FORCED_HOST} (from host_url HA-config)"
    HOST="${_FORCED_HOST}"
else
    # Auto-detect this container's own IP via hostname -I. Robust against
    # DHCP/Container-restart IP changes; uses the first non-loopback IPv4.
    # IMPORTANT: this is the container's OWN IP on the HA bridge net
    # (e.g. 172.30.33.x). It's NOT reachable from your laptop unless
    # HA maps ports. Set host_url in HA Configuration to your HA-host
    # LAN IP (e.g. http://192.168.0.6:3000) for browser-friendly URLs.
    _DEFAULT_HOST="$(hostname -I 2>/dev/null | awk '{print $1}')"
    if [ -z "${_DEFAULT_HOST}" ]; then
        # Last-resort fallback if hostname -I yields nothing.
        _DEFAULT_HOST="0.0.0.0"
        echo "[10-config] WARNING: hostname -I failed, falling back to HOST=0.0.0.0 (UI links will be unreachable)"
    else
        echo "[10-config] no host_url set — auto-detected HOST=${_DEFAULT_HOST} (this container's IP; set host_url in HA Configuration for browser-friendly URLs)"
    fi
    HOST="${_DEFAULT_HOST}"
fi

# ---- Read options ----
STEEL_PORT="$(_bashio_config 'steel_port' '3000')"
STEEL_API_KEY="$(_bashio_config 'steel_api_key' '')"
CHROME_HEADLESS="$(_bashio_config 'chrome_headless' 'true')"
# CHROME_ARGS comes in as a comma-separated string. We replace commas with
# spaces for env var consumption. If empty, leave unset.
CHROME_ARGS_RAW="$(_bashio_config 'chrome_args' '--no-sandbox,--disable-dev-shm-usage')"
if [ -n "${CHROME_ARGS_RAW}" ]; then
    CHROME_ARGS="$(echo "${CHROME_ARGS_RAW}" | tr ',' ' ')"
else
    unset CHROME_ARGS
fi
LOG_LEVEL="$(_bashio_config 'log_level' 'warn')"
DATA_PATH="$(_bashio_config 'data_path' '/share/steel')"
SKIP_FINGERPRINT_INJECTION="$(_bashio_config 'skip_fingerprint_injection' 'false')"
DEFAULT_TIMEZONE="$(_bashio_config 'default_timezone' '')"
PROXY_URL="$(_bashio_config 'proxy_url' '')"
# Public host Steel should embed in self-generated URLs (UI links,
# debugUrl, devtoolsInspectorUrl). If empty, Steel will use the
# request's Host header (which works behind HA's host networking but
# breaks for direct browser access). Set this in the HA Configuration
# tab to the URL you actually open in your browser.
HOST_URL="$(_bashio_config 'host_url' '')"

# ---- Prepare persistent dirs ----
# Steel writes browser profile state (cookies, localStorage, IndexedDB)
# under its data root. We mount /share/steel via map: share:rw so this
# survives container restarts and addon updates.
mkdir -p "${DATA_PATH}" \
         "${DATA_PATH}/profiles" \
         "${DATA_PATH}/sessions" \
         "${DATA_PATH}/logs" \
         "${DATA_PATH}/cache"
chmod -R 777 "${DATA_PATH}"
echo "[10-config] data dir ready: $(ls -ld ${DATA_PATH})"

# ---- Export ----
# Map addon option names to Steel's expected env var names (see steel's
# .env.example). All are env-var-driven; no config files to template.
export PORT="${STEEL_PORT}"
# ALWAYS export HOST (either from host_url or the hardcoded fallback
# set above). Leaving HOST unset lets Steel fall back to its own default
# of "0.0.0.0", which makes every self-generated UI/CDP URL unreachable
# from a real browser. We chose 172.30.32.1 (Supervisor bridge IP) as a
# reasonable default; override via host_url in the HA Configuration tab.
export HOST="${HOST}"
export CDP_REDIRECT_PORT="${STEEL_PORT_CDP:-9223}"
export NODE_ENV=production
export CHROME_HEADLESS
if [ -n "${CHROME_ARGS:-}" ]; then
    export CHROME_ARGS
fi
export LOG_LEVEL
export STEEL_DATA_PATH="${DATA_PATH}"
export SKIP_FINGERPRINT_INJECTION
if [ -n "${DEFAULT_TIMEZONE}" ]; then
    export DEFAULT_TIMEZONE
fi
if [ -n "${PROXY_URL}" ]; then
    export PROXY_URL
fi

# Optional API key (if user set one in HA UI for extra protection).
# Steel self-hosted doesn't require it; only needed if you want to lock
# down the API endpoint. Note: as of steel-browser 2026-08, API-key
# enforcement is experimental — see docs.steel.dev/api-reference.
if [ -n "${STEEL_API_KEY}" ]; then
    export STEEL_API_KEY
    export AUTH_ENABLED=true
fi

# Write a summary (no secrets) for post-mortem debugging
{
    echo "DATA_PATH=${DATA_PATH}"
    echo "PORT=${PORT}"
    echo "HOST=${HOST:-<unset — falls back to req.hostname>}"
    echo "CDP_REDIRECT_PORT=${CDP_REDIRECT_PORT}"
    echo "LOG_LEVEL=${LOG_LEVEL}"
    echo "CHROME_HEADLESS=${CHROME_HEADLESS}"
    echo "CHROME_ARGS=${CHROME_ARGS:-<unset>}"
    echo "STEEL_DATA_PATH=${STEEL_DATA_PATH}"
    echo "SKIP_FINGERPRINT_INJECTION=${SKIP_FINGERPRINT_INJECTION}"
    echo "DEFAULT_TIMEZONE=${DEFAULT_TIMEZONE:-<unset>}"
    echo "PROXY_URL=${PROXY_URL:+<set>}${PROXY_URL:-<unset>}"
    echo "STEEL_API_KEY=${STEEL_API_KEY:+<set>}${STEEL_API_KEY:-<unset>}"
    echo "NODE_ENV=${NODE_ENV}"
} > "${DATA_PATH}/logs/options.env"
chmod 600 "${DATA_PATH}/logs/options.env"

# Persist exports to /tmp/.steel-env so the s6 service run script can
# re-source them (s6-overlay runs cont-init and service as separate
# process trees — exports don't propagate).
_ENV_TMP="/tmp/.steel-env"
{
    echo "export PORT='${PORT}'"
    echo "export HOST='${HOST}'"
    echo "export CDP_REDIRECT_PORT='${CDP_REDIRECT_PORT}'"
    echo "export NODE_ENV='${NODE_ENV}'"
    echo "export CHROME_HEADLESS='${CHROME_HEADLESS}'"
    [ -n "${CHROME_ARGS:-}" ] && echo "export CHROME_ARGS='${CHROME_ARGS}'"
    echo "export LOG_LEVEL='${LOG_LEVEL}'"
    echo "export STEEL_DATA_PATH='${STEEL_DATA_PATH}'"
    echo "export SKIP_FINGERPRINT_INJECTION='${SKIP_FINGERPRINT_INJECTION}'"
    [ -n "${DEFAULT_TIMEZONE:-}" ] && echo "export DEFAULT_TIMEZONE='${DEFAULT_TIMEZONE}'"
    [ -n "${PROXY_URL:-}" ] && echo "export PROXY_URL='${PROXY_URL}'"
    [ -n "${STEEL_API_KEY:-}" ] && echo "export STEEL_API_KEY='${STEEL_API_KEY}'"
    [ -n "${STEEL_API_KEY:-}" ] && echo "export AUTH_ENABLED=true"
} > "${_ENV_TMP}"
chmod 600 "${_ENV_TMP}"

echo "[10-config] options written to ${DATA_PATH}/logs/options.env"
echo "[10-config] env file: ${_ENV_TMP}"
# DEBUG v0.1.4: show what was actually exported (post-fix state).
echo "[10-config] DEBUG exported HOST='${HOST:-<unset>}' HOST_URL='${HOST_URL:-<unset>}'"
echo "[10-config] OK — handing off to steel service"

# Re-enable -e so a fatal misconfig below this line still fails the
# container (defensive against future code additions).
set -e
